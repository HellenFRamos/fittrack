<%- include('../../partials/head') %>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">
<main class="ft-card w-100" style="max-width: 460px;" id="conteudo">
  <span class="ft-marca mb-3"><span class="logo" aria-hidden="true">F</span>FitTrack</span>
  <h1 class="h4 mb-1">Olá, <%= f.primeiroNome(usuario.nome) %>! Defina sua senha</h1>
  <p class="text-muted small">Sua conta foi criada pelo seu administrador com uma senha provisória. Para continuar, escolha uma senha só sua.</p>
  <form method="post" action="/primeiro-acesso" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-3">
      <label class="form-label obrig" for="senha">Nova senha</label>
      <input class="form-control <%= erros.senha ? 'is-invalid' : '' %>" type="password" id="senha" name="senha" autocomplete="new-password" required autofocus>
      <div class="form-text">Mínimo de 8 caracteres, com letras e números.</div>
      <%- include('../../partials/erro-campo', { campo: 'senha' }) %>
    </div>
    <div class="mb-3">
      <label class="form-label obrig" for="confirmacao">Confirmar nova senha</label>
      <input class="form-control <%= erros.confirmacao ? 'is-invalid' : '' %>" type="password" id="confirmacao" name="confirmacao" autocomplete="new-password" required>
      <%- include('../../partials/erro-campo', { campo: 'confirmacao' }) %>
    </div>
    <button class="btn btn-primary w-100" type="submit">Salvar e continuar</button>
  </form>
  <form method="post" action="/sair" class="text-center mt-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-link btn-sm" type="submit">Sair</button>
  </form>
</main>
</body>
</html>
