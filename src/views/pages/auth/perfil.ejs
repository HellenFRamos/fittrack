<%- include('../../partials/app-topo') %>
<div class="ft-cabecalho">
  <div><h1>Meu perfil</h1><div class="sub"><%= f.ROTULOS.perfil[usuario.tipo_perfil] %> · cadastrado em <%= d.br(usuario.criado_em) %></div></div>
</div>

<% if (administrador) { %>
  <div class="ft-aviso info mb-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Sua conta é gerenciada por <strong><%= administrador.nome %></strong>. Seus treinos, metas e medidas são atualizados por ele(a).</div>
<% } %>

<div class="row g-3">
  <div class="col-lg-7">
    <section class="ft-card" aria-labelledby="tDados">
      <h2 id="tDados">Dados pessoais</h2>
      <form method="post" action="/perfil" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label obrig" for="nome">Nome completo</label>
          <input class="form-control <%= erros.nome ? 'is-invalid' : '' %>" id="nome" name="nome" value="<%= dados.nome %>" maxlength="100" required>
          <%- include('../../partials/erro-campo', { campo: 'nome' }) %>
        </div>
        <div class="mb-3">
          <label class="form-label" for="email">E-mail (login)</label>
          <input class="form-control" id="email" value="<%= usuario.email %>" readonly aria-describedby="ajudaEmail">
          <div id="ajudaEmail" class="form-text">O e-mail é o seu identificador de acesso e não pode ser alterado.</div>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-sm-5">
            <label class="form-label obrig" for="data_nascimento">Nascimento</label>
            <input class="form-control <%= erros.data_nascimento ? 'is-invalid' : '' %>" type="date" id="data_nascimento" name="data_nascimento" value="<%= dados.data_nascimento || '' %>" max="<%= d.hojeISO() %>">
            <%- include('../../partials/erro-campo', { campo: 'data_nascimento' }) %>
          </div>
          <div class="col-sm-4">
            <label class="form-label obrig" for="sexo">Sexo</label>
            <select class="form-select <%= erros.sexo ? 'is-invalid' : '' %>" id="sexo" name="sexo">
              <option value="">Selecione</option>
              <% Object.entries(f.ROTULOS.sexo).forEach(function ([k, v]) { %>
                <option value="<%= k %>" <%= dados.sexo === k ? 'selected' : '' %>><%= k === 'O' ? 'Outro' : v %></option>
              <% }) %>
            </select>
            <%- include('../../partials/erro-campo', { campo: 'sexo' }) %>
          </div>
          <div class="col-sm-3">
            <label class="form-label" for="altura_cm">Altura (cm)</label>
            <input class="form-control <%= erros.altura_cm ? 'is-invalid' : '' %>" type="number" id="altura_cm" name="altura_cm" min="50" max="260" value="<%= dados.altura_cm || '' %>">
            <%- include('../../partials/erro-campo', { campo: 'altura_cm' }) %>
          </div>
        </div>
        <button class="btn btn-primary" type="submit">Salvar</button>
      </form>
    </section>
  </div>

  <div class="col-lg-5">
    <section class="ft-card mb-3" aria-labelledby="tSenha">
      <h2 id="tSenha">Trocar senha</h2>
      <form method="post" action="/perfil/senha" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-2">
          <label class="form-label" for="senha_atual">Senha atual</label>
          <input class="form-control <%= errosSenha.senha_atual ? 'is-invalid' : '' %>" type="password" id="senha_atual" name="senha_atual" autocomplete="current-password">
          <%- include('../../partials/erro-campo', { erros: errosSenha, campo: 'senha_atual' }) %>
        </div>
        <div class="mb-2">
          <label class="form-label" for="nova_senha">Nova senha</label>
          <input class="form-control <%= errosSenha.nova_senha ? 'is-invalid' : '' %>" type="password" id="nova_senha" name="nova_senha" autocomplete="new-password">
          <%- include('../../partials/erro-campo', { erros: errosSenha, campo: 'nova_senha' }) %>
        </div>
        <div class="mb-3">
          <label class="form-label" for="confirmacao">Confirmar nova senha</label>
          <input class="form-control <%= errosSenha.confirmacao ? 'is-invalid' : '' %>" type="password" id="confirmacao" name="confirmacao" autocomplete="new-password">
          <%- include('../../partials/erro-campo', { erros: errosSenha, campo: 'confirmacao' }) %>
        </div>
        <button class="btn btn-outline-secondary" type="submit">Alterar senha</button>
      </form>
    </section>

    <% if (usuario.tipo_perfil === 'PESSOAL') { %>
      <section class="ft-card" aria-labelledby="tExcluir" style="border-color: #F1C7B5;">
        <h2 id="tExcluir">Excluir minha conta</h2>
        <p class="small text-muted">Remove definitivamente a sua conta e todos os seus treinos, metas e medidas (LGPD). Esta ação não pode ser desfeita.</p>
        <form method="post" action="/perfil/excluir" data-confirmar="Excluir definitivamente a sua conta e todos os seus dados? Esta ação não pode ser desfeita." novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="form-label" for="senha_exclusao">Confirme com a sua senha</label>
          <input class="form-control mb-2 <%= errosExclusao.senha_exclusao ? 'is-invalid' : '' %>" type="password" id="senha_exclusao" name="senha_exclusao" autocomplete="current-password">
          <%- include('../../partials/erro-campo', { erros: errosExclusao, campo: 'senha_exclusao' }) %>
          <button class="btn btn-perigo mt-1" type="submit">Excluir minha conta</button>
        </form>
      </section>
    <% } %>
  </div>
</div>
<%- include('../../partials/app-rodape') %>
