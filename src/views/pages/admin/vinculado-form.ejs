<%- include('../../partials/app-topo') %>
<div class="ft-cabecalho">
  <div><h1><%= titulo %></h1>
    <div class="ft-migalhas"><a href="/admin/vinculados">Usuários vinculados</a> › <%= novo ? 'Novo' : dados.nome %></div></div>
</div>
<% if (Object.keys(erros).length) { %><div class="ft-aviso erro mb-3" role="alert">Os dados não foram salvos. Corrija os campos destacados.</div><% } %>
<form class="ft-card" method="post" action="<%= acao %>" novalidate style="max-width: 760px;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3">
    <div class="col-md-7">
      <label class="form-label obrig" for="nome">Nome completo</label>
      <input class="form-control <%= erros.nome ? 'is-invalid' : '' %>" id="nome" name="nome" value="<%= dados.nome %>" maxlength="100" required>
      <%- include('../../partials/erro-campo', { campo: 'nome' }) %>
    </div>
    <div class="col-md-5">
      <label class="form-label obrig" for="email">E-mail (login do aluno)</label>
      <input class="form-control <%= erros.email ? 'is-invalid' : '' %>" type="email" id="email" name="email" value="<%= dados.email %>" maxlength="120" required>
      <% if (erros.email === 'emUso') { %><div class="invalid-feedback d-block">Este e-mail já está cadastrado no FitTrack.</div><% } else { %><%- include('../../partials/erro-campo', { campo: 'email' }) %><% } %>
    </div>
    <div class="col-sm-5">
      <label class="form-label obrig" for="data_nascimento">Nascimento</label>
      <input class="form-control <%= erros.data_nascimento ? 'is-invalid' : '' %>" type="date" id="data_nascimento" name="data_nascimento" value="<%= dados.data_nascimento || '' %>" max="<%= d.hojeISO() %>">
      <%- include('../../partials/erro-campo', { campo: 'data_nascimento' }) %>
    </div>
    <div class="col-sm-4">
      <label class="form-label obrig" for="sexo">Sexo</label>
      <select class="form-select <%= erros.sexo ? 'is-invalid' : '' %>" id="sexo" name="sexo">
        <option value="">Selecione</option>
        <% Object.entries(f.ROTULOS.sexo).forEach(function ([k, r]) { %><option value="<%= k %>" <%= dados.sexo === k ? 'selected' : '' %>><%= k === 'O' ? 'Outro' : r %></option><% }) %>
      </select>
      <%- include('../../partials/erro-campo', { campo: 'sexo' }) %>
    </div>
    <div class="col-sm-3">
      <label class="form-label" for="altura_cm">Altura (cm)</label>
      <input class="form-control <%= erros.altura_cm ? 'is-invalid' : '' %>" type="number" id="altura_cm" name="altura_cm" min="50" max="260" value="<%= dados.altura_cm || '' %>">
      <%- include('../../partials/erro-campo', { campo: 'altura_cm' }) %>
    </div>
    <% if (novo) { %>
      <div class="col-md-6">
        <label class="form-label obrig" for="senha_provisoria">Senha provisória</label>
        <div class="input-group">
          <input class="form-control <%= erros.senha_provisoria ? 'is-invalid' : '' %>" id="senha_provisoria" name="senha_provisoria" value="<%= dados.senha_provisoria %>" autocomplete="off" aria-describedby="ajudaProv">
          <button class="btn btn-outline-secondary" type="button" data-acao="gerar-senha" aria-label="Gerar outra senha"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></button>
        </div>
        <%- include('../../partials/erro-campo', { campo: 'senha_provisoria' }) %>
        <div id="ajudaProv" class="form-text">O aluno será obrigado a trocá-la no primeiro acesso.</div>
      </div>
    <% } %>
  </div>
  <div class="d-flex gap-2 mt-3">
    <button class="btn btn-admin" type="submit"><%= novo ? 'Cadastrar vinculado' : 'Salvar alterações' %></button>
    <a class="btn btn-outline-secondary" href="<%= novo ? '/admin/vinculados' : `/admin/vinculados/${dados.id_usuario}` %>">Cancelar</a>
  </div>
</form>
<%- include('../../partials/app-rodape') %>
