<%- include('../../partials/app-topo') %>
<div class="ft-cabecalho"><div><h1><%= c.redefinida ? 'Senha provisória gerada' : 'Vinculado cadastrado' %></h1>
  <div class="ft-migalhas"><a href="/admin/vinculados">Usuários vinculados</a> › <%= c.nome %></div></div></div>
<section class="ft-card" style="max-width: 560px; border-color: #DCD6F4;">
  <p class="mb-3"><%= c.redefinida ? 'Repasse a nova senha provisória' : 'Repasse as credenciais provisórias' %> para <strong><%= c.nome %></strong>. No primeiro acesso, o aluno deverá definir uma senha própria.</p>
  <dl class="row mb-3">
    <dt class="col-sm-4 text-muted fw-normal">Endereço</dt><dd class="col-sm-8"><code>http://localhost:<%= process.env.PORT || 3000 %>/entrar</code></dd>
    <dt class="col-sm-4 text-muted fw-normal">E-mail</dt><dd class="col-sm-8"><code><%= c.email %></code></dd>
    <dt class="col-sm-4 text-muted fw-normal">Senha provisória</dt><dd class="col-sm-8"><code class="fs-5"><%= c.senha %></code></dd>
  </dl>
  <div class="ft-aviso pessego small mb-3"><i class="bi bi-eye-slash me-1" aria-hidden="true"></i>Esta senha é exibida somente agora. Se o aluno perdê-la, gere outra na ficha dele.</div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-admin" href="/admin/vinculados/<%= c.id %>">Abrir ficha</a>
    <a class="btn btn-outline-secondary" href="/admin/vinculados/<%= c.id %>/treinos/novo">Atribuir primeiro treino</a>
    <a class="btn btn-link" href="/admin/vinculados">Voltar à lista</a>
  </div>
</section>
<%- include('../../partials/app-rodape') %>
